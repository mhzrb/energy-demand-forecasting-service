# Copy to .env for Docker Compose. Never commit .env.
GRAFANA_ADMIN_PASSWORD=replace-with-your-local-password
# Local Python commands read exported environment variables, not .env automatically.
ENERGY_RUNTIME=runtime
# Leave unset for the default absolute local file URI.
# MLFLOW_TRACKING_URI=file:///absolute/path/to/runtime/mlruns
INSIGHT_PROVIDER=template
# Optional remote provider is NOT VERIFIED. It can incur provider costs if enabled.
# No provider calls are made by default.
# INSIGHT_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model
# LLM_API_KEY=
